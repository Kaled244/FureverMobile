<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F9F8F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/star_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_marginStart="37dp"
            android:layout_marginTop="8dp"
            android:src="@android:drawable/star_big_on" />

        <!-- Filters -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="37dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_filter_active"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="All Pets"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/filter_species"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_filter_inactive"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="Species >"
                    android:textColor="#3A2525" />

                <TextView
                    android:id="@+id/filter_breed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:alpha="0.5"
                    android:background="@drawable/bg_filter_inactive"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="Breed >"
                    android:textColor="#3A2525" />
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_pets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:listitem="@layout/item_pet_card" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
